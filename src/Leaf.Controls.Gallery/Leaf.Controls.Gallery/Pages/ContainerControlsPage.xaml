<Page x:Class="Leaf.Controls.Gallery.Pages.ContainerControlsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PrimaryRegionBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource GalleryHeaderTextStyle}" Text="容器与导航" />
            <TextBlock Style="{StaticResource GalleryDescriptionTextStyle}" Text="TabControl / Menu / ContextMenu / ScrollViewer / ScrollBar" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="菜单">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Menu>
                        <MenuItem Header="文件">
                            <MenuItem Header="新建" />
                            <MenuItem Header="打开" />
                        </MenuItem>
                        <MenuItem Header="帮助">
                            <MenuItem Header="关于" />
                        </MenuItem>
                    </Menu>
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="右键此区域可查看 ContextMenu"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="复制" />
                                    <MenuItem Header="粘贴" />
                                    <Separator />
                                    <MenuItem Header="删除" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="滚动">
                <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="滚动内容示例" FontWeight="SemiBold" />
                        <ItemsControl>
                            <ItemsControl.Items>
                                <TextBlock Text="条目 01" Margin="0,8,0,0" />
                                <TextBlock Text="条目 02" Margin="0,8,0,0" />
                                <TextBlock Text="条目 03" Margin="0,8,0,0" />
                                <TextBlock Text="条目 04" Margin="0,8,0,0" />
                                <TextBlock Text="条目 05" Margin="0,8,0,0" />
                                <TextBlock Text="条目 06" Margin="0,8,0,0" />
                                <TextBlock Text="条目 07" Margin="0,8,0,0" />
                                <TextBlock Text="条目 08" Margin="0,8,0,0" />
                                <TextBlock Text="条目 09" Margin="0,8,0,0" />
                                <TextBlock Text="条目 10" Margin="0,8,0,0" />
                                <TextBlock Text="条目 11" Margin="0,8,0,0" />
                                <TextBlock Text="条目 12" Margin="0,8,0,0" />
                                <TextBlock Text="条目 13" Margin="0,8,0,0" />
                                <TextBlock Text="条目 14" Margin="0,8,0,0" />
                                <TextBlock Text="条目 15" Margin="0,8,0,0" />
                                <TextBlock Text="条目 16" Margin="0,8,0,0" />
                                <TextBlock Text="条目 17" Margin="0,8,0,0" />
                                <TextBlock Text="条目 18" Margin="0,8,0,0" />
                                <TextBlock Text="条目 19" Margin="0,8,0,0" />
                                <TextBlock Text="条目 20" Margin="0,8,0,0" />
                            </ItemsControl.Items>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
