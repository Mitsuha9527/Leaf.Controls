<Page x:Class="Leaf.Controls.Gallery.Pages.AttachPropertiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:leaf="http://schemas.Leaf.Controls.com"
      xmlns:controls="clr-namespace:Leaf.Controls.CustomControls;assembly=Leaf.Controls"
      Background="{DynamicResource PrimaryRegionBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource GalleryPageMargin}">
            <TextBlock Style="{StaticResource GalleryHeaderTextStyle}" Text="附加属性" />
            <TextBlock Style="{StaticResource GalleryDescriptionTextStyle}" Text="BorderElement / IconElement / TextBoxAttatch / TitleElement" />

            <Border Padding="16"
                    Margin="0,0,0,12"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    controls:BorderElement.CornerRadius="12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="BorderElement.CornerRadius" />
                    <TextBlock Margin="0,6,0,0" Text="该 Border 使用附加属性设置圆角。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Margin="0,0,12,0"
                        Content="IconElement 示例"
                        controls:IconElement.DrawingIcon="{StaticResource SuccessIcon}" />
                <TextBox Width="280"
                         controls:TextBoxAttatch.UpdateSourceOnKey="Enter"
                         Text="输入后按 Enter 更新绑定源（附加行为示例）" />
            </StackPanel>

            <ProgressBar Height="22"
                         Minimum="0"
                         Maximum="100"
                         Value="45"
                         controls:TitleElement.Title="进度标题"
                         controls:TitleElement.TitlePlacement="Top" />
        </StackPanel>
    </ScrollViewer>
</Page>
