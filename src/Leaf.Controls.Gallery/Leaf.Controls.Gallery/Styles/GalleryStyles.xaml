<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Leaf.Controls.CustomControls;assembly=Leaf.Controls">

    <Thickness x:Key="GalleryPageMargin">24</Thickness>

    <Style x:Key="GalleryHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="GalleryDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,16" />
        <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
    </Style>

    <Style x:Key="GalleryCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="controls:BorderElement.CornerRadius" Value="8" />
    </Style>

</ResourceDictionary>
