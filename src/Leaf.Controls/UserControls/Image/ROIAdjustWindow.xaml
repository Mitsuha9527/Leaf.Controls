<leaf:LeafWindow
    x:Class="Leaf.Controls.UserControls.Image.ROIAdjustWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:leaf="clr-namespace:Leaf.Controls.CustomControls"
    xmlns:local="clr-namespace:Leaf.Controls.UserControls.Image"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="调整ROI位置"
    Width="300"
    Height="300"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource LightPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <Style BasedOn="{StaticResource ButtonBaseStyle}" TargetType="Button">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Width" Value="75" />
                <Setter Property="Height" Value="75" />
            </Style>
        </Grid.Resources>
        <Button
            Grid.Row="0"
            Grid.Column="1"
            Click="MoveUp_Click"
            Content="↑" />
        <Button
            Grid.Row="1"
            Grid.Column="0"
            Click="MoveLeft_Click"
            Content="←" />
        <leaf:NumberBox
            x:Name="AdjustValue_Numberbox"
            Grid.Row="1"
            Grid.Column="1"
            Width="75"
            Height="75"
            MaxHeight="100"
            HorizontalContentAlignment="Center"
            FontSize="24"
            Increment="5"
            Minimum="1"
            ShowUpDownButton="False"
            Value="5" />
        <Button
            Grid.Row="1"
            Grid.Column="2"
            Click="MoveRight_Click"
            Content="→" />
        <Button
            Grid.Row="2"
            Grid.Column="1"
            Click="MoveDown_Click"
            Content="↓" />
    </Grid>
</leaf:LeafWindow>
