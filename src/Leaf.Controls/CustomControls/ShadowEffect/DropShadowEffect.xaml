<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <DropShadowEffect
        x:Key="ShadowEffect1"
        BlurRadius="15"
        Opacity="0.2"
        RenderingBias="Performance"
        ShadowDepth="0"
        Color="{DynamicResource PrimaryColor}" />

    <DropShadowEffect
        x:Key="ShadowEffect2"
        BlurRadius="8"
        Direction="270"
        Opacity=".2"
        RenderingBias="Performance"
        ShadowDepth="1.5"
        Color="{DynamicResource PrimaryColor}" />


</ResourceDictionary>