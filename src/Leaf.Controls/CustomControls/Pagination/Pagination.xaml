<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="clr-namespace:Leaf.Controls.Utilities"
                    xmlns:leafui="clr-namespace:Leaf.Controls.CustomControls">

    <ResourceDictionary.MergedDictionaries>
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/Resources/GeometryItems/GeometryItems.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/Button/Button.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/RadioButton/RadioButton.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/NumberBox/NumberBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  分页按钮基础样式  -->
    <Style x:Key="PaginationButtonBaseStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RegionBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="leafui:BorderElement.CornerRadius" Value="4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(leafui:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MouseMoveBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LightPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MousePressBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  分页导航按钮样式（上一页/下一页）  -->
    <Style x:Key="PaginationNavButtonStyle"
           BasedOn="{StaticResource PaginationButtonBaseStyle}"
           TargetType="Button">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(leafui:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <StackPanel Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Path x:Name="PART_Icon"
                                  Width="12"
                                  Height="12"
                                  Margin="0,0,4,0"
                                  VerticalAlignment="Center"
                                  Data="{TemplateBinding leafui:IconElement.Geometry}"
                                  Fill="{TemplateBinding Foreground}"
                                  Stretch="Uniform" />
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Icon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="leafui:IconElement.Geometry" Value="{x:Null}">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MouseMoveBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LightPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MousePressBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  分页页码RadioButton样式  -->
    <Style x:Key="PaginationRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RegionBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="leafui:BorderElement.CornerRadius" Value="4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(leafui:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MouseMoveBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LightPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MousePressBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LightPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  省略号样式  -->
    <Style x:Key="PaginationMoreStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="..." />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <!--  跳转输入框样式  -->
    <Style x:Key="PaginationJumpStyle"
           BasedOn="{StaticResource NumberBoxBaseStyle}"
           TargetType="leafui:NumberBox">
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="MaxWidth" Value="80" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="leafui:BorderElement.CornerRadius" Value="4" />
    </Style>

    <!--  分页控件主样式  -->
    <Style x:Key="PaginationBaseStyle" TargetType="leafui:Pagination">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="leafui:Pagination">
                    <StackPanel x:Name="PART_Root"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <!--  上一页按钮  -->
                        <Button x:Name="PART_ButtonLeft"
                                leafui:IconElement.Geometry="{StaticResource LeftGeometry}"
                                Command="{x:Static leafui:Pagination.PrevCommand}"
                                Style="{StaticResource PaginationNavButtonStyle}" />

                        <!--  第一页按钮  -->
                        <RadioButton x:Name="PART_ButtonFirst"
                                     Command="{x:Static leafui:Pagination.SelectedCommand}"
                                     Content="1"
                                     GroupName="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Name}"
                                     Style="{StaticResource PaginationRadioButtonStyle}" />

                        <!--  左侧省略号  -->
                        <TextBlock x:Name="PART_MoreLeft"
                                   Style="{StaticResource PaginationMoreStyle}"
                                   Visibility="Collapsed" />

                        <!--  页码按钮容器  -->
                        <StackPanel x:Name="PART_PanelMain" Orientation="Horizontal" />

                        <!--  右侧省略号  -->
                        <TextBlock x:Name="PART_MoreRight"
                                   Style="{StaticResource PaginationMoreStyle}"
                                   Visibility="Collapsed" />
                        <!--  最后一页按钮  -->
                        <RadioButton x:Name="PART_ButtonLast"
                                     Command="{x:Static leafui:Pagination.SelectedCommand}"
                                     Content="N"
                                     GroupName="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Name}"
                                     Style="{StaticResource PaginationRadioButtonStyle}" />

                        <!--  跳转功能  -->
                        <StackPanel x:Name="PART_JumpPanel"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <TextBlock Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="跳转至" />
                            <leafui:NumberBox x:Name="PART_Jump"
                                             Minimum="1"
                                             Style="{StaticResource PaginationJumpStyle}" />
                            <TextBlock Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="页" />
                        </StackPanel>
                        <!--  下一页按钮  -->
                        <Button x:Name="PART_ButtonRight"
                                Margin="15,0,0,0"
                                leafui:IconElement.Geometry="{StaticResource RightGeometry}"
                                Command="{x:Static leafui:Pagination.NextCommand}"
                                Style="{StaticResource PaginationNavButtonStyle}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!--  当启用跳转功能时显示跳转面板  -->
                        <Trigger Property="IsJumpEnabled" Value="True">
                            <Setter TargetName="PART_JumpPanel" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  当只有一页时隐藏整个控件（如果启用了AutoHiding）  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="AutoHiding" Value="True" />
                                <Condition Property="MaxPageCount" Value="1" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Root" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  默认分页样式  -->
    <Style BasedOn="{StaticResource PaginationBaseStyle}" TargetType="leafui:Pagination" />

</ResourceDictionary>
