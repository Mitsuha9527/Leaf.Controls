<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:leafui="clr-namespace:Leaf.Controls.CustomControls">

    <!--  RadioButtonGroup样式的RadioButton样式  -->
    <Style x:Key="RadioButtonGroupItemStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="PART_Root">
                        <!--  悬停指示线 (会在IsMouseOver时显示)  -->
                        <Line
                            x:Name="PART_HoverIndicator"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Fill"
                            Stroke="{DynamicResource DarkPrimaryBrush}"
                            StrokeThickness="2"
                            X1="0"
                            X2="0"
                            Y1="0"
                            Y2="1" />

                        <Border
                            x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_HoverIndicator" Property="Stroke" Value="{DynamicResource DarkPrimaryBrush}" />
                            <Setter TargetName="PART_HoverIndicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            <Setter TargetName="PART_HoverIndicator" Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="0.5" />
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LightPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  RadioButtonGroup控件模板  -->
    <ControlTemplate x:Key="RadioButtonGroupTemplate" TargetType="leafui:RadioButtonGroup">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  内容容器  -->
            <ItemsPresenter x:Name="PART_ItemsPresenter" />

            <!--  滑动指示器  -->
            <Canvas
                x:Name="PART_IndicatorCanvas"
                ClipToBounds="False"
                IsHitTestVisible="False">
                <Rectangle
                    x:Name="PART_IndicatorLine"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="0.5"
                    Height="0"
                    Fill="{DynamicResource LightPrimaryBrush}">
                    <Rectangle.Effect>
                        <DropShadowEffect
                            BlurRadius="3"
                            Opacity="0.2"
                            ShadowDepth="1"
                            Color="{DynamicResource PrimaryColor}" />
                    </Rectangle.Effect>
                </Rectangle>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_IndicatorLine" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--  RadioButtonGroup样式  -->
    <Style TargetType="leafui:RadioButtonGroup">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource RadioButtonGroupTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RadioButtonGroupItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
