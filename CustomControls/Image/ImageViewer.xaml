<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:leaf="clr-namespace:Leaf.Controls.CustomControls">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="LimeGreen" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle
                        Fill="{TemplateBinding Background}"
                        Stroke="{TemplateBinding BorderBrush}"
                        StrokeThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="leaf:ImageViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="leaf:ImageViewer">
                    <Border
                        x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True">
                        <leaf:SimplePanel
                            x:Name="PART_Panel"
                            Width="{TemplateBinding ImageWidth}"
                            Height="{TemplateBinding ImageHeight}"
                            Margin="{TemplateBinding ImageMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Image
                                x:Name="PART_Image"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                RenderTransformOrigin="0.5,0.5"
                                Source="{TemplateBinding ImageSource}" />
                            <!--  ROI 渲染层  -->
                            <ItemsControl ItemsSource="{Binding ROIs, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Rect.X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Rect.Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type leaf:ROI}">
                                        <leaf:SimplePanel Width="{Binding Rect.Width}" Height="{Binding Rect.Height}">
                                            <!--  ROI 主体矩形  -->
                                            <Rectangle Fill="#40FF0000">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Stroke" Value="Red" />
                                                        <Setter Property="StrokeThickness" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="LimeGreen" />
                                                                <Setter Property="StrokeDashArray" Value="2 2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>

                                            <!--  缩放句柄  -->
                                            <leaf:SimplePanel Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Thumb
                                                    Margin="-4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Cursor="SizeNWSE"
                                                    Style="{StaticResource ResizeThumbStyle}"
                                                    Tag="TopLeft" />
                                                <Thumb
                                                    Margin="-4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Cursor="SizeNS"
                                                    Style="{StaticResource ResizeThumbStyle}"
                                                    Tag="TopCenter" />
                                                <Thumb
                                                    Margin="-4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Cursor="SizeNESW"
                                                    Style="{StaticResource ResizeThumbStyle}"
                                                    Tag="TopRight" />
                                                <Thumb
                                                    Margin="-4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Cursor="SizeWE"
                                                    Style="{StaticResource ResizeThumbStyle}"
                                                    Tag="MiddleLeft" />
                                                <Thumb
                                                    Margin="-4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Cursor="SizeWE"
                                                    Style="{StaticResource ResizeThumbStyle}"
                                                    Tag="MiddleRight" />
                                                <Thumb
                                                    Margin="-4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Cursor="SizeNESW"
                                                    Style="{StaticResource ResizeThumbStyle}"
                                                    Tag="BottomLeft" />
                                                <Thumb
                                                    Margin="-4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    Cursor="SizeNS"
                                                    Style="{StaticResource ResizeThumbStyle}"
                                                    Tag="BottomCenter" />
                                                <Thumb
                                                    Margin="-4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Cursor="SizeNWSE"
                                                    Style="{StaticResource ResizeThumbStyle}"
                                                    Tag="BottomRight" />
                                            </leaf:SimplePanel>
                                        </leaf:SimplePanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </leaf:SimplePanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>