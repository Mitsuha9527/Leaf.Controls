<leafui:LeafWindow
    x:Class="Leaf.Controls.CustomControls.LeafMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:leafui="clr-namespace:Leaf.Controls.CustomControls"
    xmlns:local="clr-namespace:Leaf.Controls.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:Leaf.Controls.Utilities"
    Title="LeafMessageBox"
    Width="400"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Style="{StaticResource DefaultLeafWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <leafui:LeafWindow.Resources>
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/Resources/Icons/SvgImageIcons.xaml" />
    </leafui:LeafWindow.Resources>
    <Grid Background="{DynamicResource SecondaryRegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <leafui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            leafui:IconElement.Height="24"
            leafui:IconElement.Width="24"
            Background="Transparent"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <TextBlock Name="Text_Title" d:Text="Error" />
        </leafui:TitleBar>
        <TextBlock
            Name="Text_Message"
            Grid.Row="1"
            Margin="35,20"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            d:Text="这是一个MessageBox！"
            TextWrapping="Wrap" />
        <Grid
            x:Name="Grid_Password"
            Grid.Row="1"
            Margin="25,5"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TextBlock_PasswordPrompt"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                d:Text="请输入密码："
                FontSize="12" />
            <PasswordBox
                x:Name="PasswordBox_Input"
                Grid.Column="1"
                Height="30"
                Padding="8,5"
                d:Password="dsad"
                d:Visibility="Visible"
                FontSize="12"
                KeyDown="PasswordBox_Input_KeyDown" />
        </Grid>
        <TextBox
            x:Name="TextBox_Input"
            Grid.Row="1"
            Height="30"
            Margin="25,5"
            Padding="8,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            d:Text="默认输入文本"
            d:Visibility="Visible"
            FontSize="12"
            KeyDown="TextBox_Input_KeyDown"
            Visibility="Collapsed" />
        <StackPanel
            Grid.Row="3"
            Margin="25,5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="ButtonConfirm"
                Width="50"
                Click="ButtonConfirm_Click"
                Content="确定" />
            <Button
                x:Name="ButtonYes"
                Width="50"
                Click="ButtonYes_Click"
                Content="是" />
            <Button
                x:Name="ButtonNo"
                Width="50"
                Click="ButtonNo_Click"
                Content="否" />
            <Button
                x:Name="ButtonCancel"
                Width="50"
                Click="ButtonCancel_Click"
                Content="取消"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</leafui:LeafWindow>
