<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cvt="clr-namespace:Leaf.Controls.Converters"
                    xmlns:utils="clr-namespace:Leaf.Controls.Utilities"
                    xmlns:leafui="clr-namespace:Leaf.Controls.CustomControls">

    <ResourceDictionary.MergedDictionaries>
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/CheckBox/CheckBox.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/ToggleButton/ToggleButton.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/Resources/GeometryItems/GeometryItems.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/Themes/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:TreeViewLineConverter x:Key="LineConverter" />

    <Style x:Key="TreeViewItemBaseStyle" TargetType="leafui:TreeViewItem">
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CheckedEnable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="leafui:IconElement.Width" Value="14" />
        <Setter Property="leafui:IconElement.Height" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="leafui:BorderElement.CornerRadius" Value="5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="leafui:TreeViewItem">
                    <Grid>
                        <Border x:Name="PART_MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Path=(leafui:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <!--  Connecting Lines  -->
                                <Rectangle x:Name="PART_HorLine"
                                           Grid.ColumnSpan="2"
                                           Height="1"
                                           Margin="7,0,0,0"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Fill="{DynamicResource LineBrush}" />
                                <Rectangle x:Name="PART_VerLine"
                                           Grid.RowSpan="3"
                                           Width="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           Fill="{DynamicResource LineBrush}" />
                                <ToggleButton x:Name="PART_ToggleExpander"
                                              Margin="0,0,0,0"
                                              Padding="0"
                                              HorizontalAlignment="Center"
                                              leafui:BorderElement.CornerRadius="{TemplateBinding leafui:BorderElement.CornerRadius}"
                                              leafui:IconElement.Geometry="{StaticResource MinusWithCircle}"
                                              leafui:IconElement.Height="14"
                                              leafui:IconElement.Width="14"
                                              Background="{TemplateBinding Background}"
                                              BorderThickness="0"
                                              ClickMode="Press"
                                              Foreground="{TemplateBinding Foreground}"
                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{StaticResource IconToggleButtonStyle}" />
                                <CheckBox x:Name="PART_CheckBox"
                                          Grid.Column="1"
                                          Margin="3,0,0,0"
                                          HorizontalAlignment="Right"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="1"
                                          IsChecked="{Binding Path=IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                          Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CheckedEnable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Image x:Name="PART_Icon"
                                       Grid.Column="2"
                                       Width="{TemplateBinding leafui:IconElement.Width}"
                                       Height="{TemplateBinding leafui:IconElement.Height}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{TemplateBinding leafui:IconElement.DrawingIcon}" />

                                <Border Name="PART_HeaderBorder"
                                        Grid.Column="3"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{Binding Path=(leafui:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="PART_Header"
                                                      MinWidth="20"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      ContentSource="Header"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ItemsPresenter x:Name="PART_ItemsHost"
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Grid.ColumnSpan="2" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsLastItem}" Value="true">
                            <Setter TargetName="PART_VerLine" Property="Height" Value="10" />
                            <Setter TargetName="PART_VerLine" Property="VerticalAlignment" Value="Top" />
                        </DataTrigger>
                        <Trigger Property="IsExpanded" Value="false">
                            <Setter TargetName="PART_ItemsHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_ToggleExpander" Property="leafui:IconElement.Geometry" Value="{StaticResource PlusWithCircle}" />
                        </Trigger>
                        <Trigger Property="leafui:IconElement.DrawingIcon" Value="{x:Null}">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="false">
                            <Setter TargetName="PART_ToggleExpander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="false" />
                                <Condition Property="Width" Value="Auto" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Header" Property="MinWidth" Value="75" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="false" />
                                <Condition Property="Height" Value="Auto" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter TargetName="PART_HeaderBorder" Property="Background" Value="{DynamicResource MousePressBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="true" />
                                <Condition Property="IsSelectionActive" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_HeaderBorder" Property="Background" Value="{DynamicResource CheckedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TreeViewItemBaseStyle}" TargetType="leafui:TreeViewItem" />

</ResourceDictionary>