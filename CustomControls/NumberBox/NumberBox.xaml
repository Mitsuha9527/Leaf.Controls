<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:leafui="clr-namespace:Leaf.Controls.CustomControls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:utils="clr-namespace:Leaf.Controls.Utilities">

    <ResourceDictionary.MergedDictionaries>
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/Base/InputElement.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/Themes/Converters.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/Resources/GeometryItems/GeometryItems.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/Button/Button.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/Base/TitleElement.xaml" />
        <utils:SharedResourceDictionary Source="/Leaf.Controls;component/CustomControls/TextBox/TextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="NumberBoxBaseStyle"
        BasedOn="{StaticResource InputElementBaseStyle}"
        TargetType="leafui:NumberBox">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="AllowDrop" Value="true" />
        <!--  为了和加了的title同高  -->
        <Setter Property="Height" Value="27" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="leafui:NumberBox">
                    <leafui:SimplePanel x:Name="PART_Root">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(leafui:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Name="PART_TextBox"
                                Grid.RowSpan="2"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="{TemplateBinding CaretBrush}"
                                Focusable="True"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                IsReadOnly="{TemplateBinding IsReadOnly}"
                                SelectionBrush="{TemplateBinding SelectionBrush}"
                                SelectionOpacity="{TemplateBinding SelectionOpacity}"
                                Style="{StaticResource TextBoxBaseStyle}" />
                            <Button
                                x:Name="UpButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="Auto"
                                Height="Auto"
                                Margin="5,3,5,1"
                                Padding="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                VerticalContentAlignment="Bottom"
                                leafui:IconElement.Geometry="{StaticResource UpGeometry}"
                                leafui:IconElement.Height="{x:Static sys:Double.NaN}"
                                leafui:IconElement.Width="{x:Static sys:Double.NaN}"
                                BorderThickness="0"
                                Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IncreaseCommand}"
                                Foreground="{TemplateBinding BorderBrush}"
                                IsEnabled="{TemplateBinding IsReadOnly,
                                                            Converter={StaticResource BooleanReConverter}}"
                                Style="{StaticResource IconButtonStyle}"
                                Visibility="{TemplateBinding ShowUpDownButton,
                                                             Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                x:Name="DownButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="Auto"
                                Height="Auto"
                                Margin="5,1,5,3"
                                Padding="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                VerticalContentAlignment="Top"
                                leafui:IconElement.Geometry="{StaticResource DownGeometry}"
                                leafui:IconElement.Height="{x:Static sys:Double.NaN}"
                                leafui:IconElement.Width="{x:Static sys:Double.NaN}"
                                BorderThickness="0"
                                Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DecreaseCommand}"
                                Foreground="{TemplateBinding BorderBrush}"
                                IsEnabled="{TemplateBinding IsReadOnly,
                                                            Converter={StaticResource BooleanReConverter}}"
                                Style="{StaticResource IconButtonStyle}"
                                Visibility="{TemplateBinding ShowUpDownButton,
                                                             Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </leafui:SimplePanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="NumberBoxExtendedStyle"
        BasedOn="{StaticResource NumberBoxBaseStyle}"
        TargetType="leafui:NumberBox">
        <Setter Property="leafui:TitleElement.TitlePlacement" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="leafui:NumberBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Path=(leafui:TitleElement.TitleWidth), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PART_TopTitleElement"
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource TitleElementTextBlockStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="PART_LeftTitleElement"
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource TitleElementTextBlockStyle}"
                            Visibility="Collapsed" />
                        <Grid
                            x:Name="PART_Root"
                            Grid.Row="1"
                            Grid.Column="1"
                            SnapsToDevicePixels="True">
                            <Border
                                x:Name="PART_ContentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Path=(leafui:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBox
                                    x:Name="PART_TextBox"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CaretBrush="{TemplateBinding CaretBrush}"
                                    Focusable="True"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    IsReadOnly="{TemplateBinding IsReadOnly}"
                                    SelectionBrush="{TemplateBinding SelectionBrush}"
                                    SelectionOpacity="{TemplateBinding SelectionOpacity}"
                                    Style="{StaticResource TextBoxBaseStyle}" />
                                <Button
                                    x:Name="UpButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="Auto"
                                    Height="Auto"
                                    Margin="5,3,5,1"
                                    Padding="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    VerticalContentAlignment="Bottom"
                                    leafui:IconElement.Geometry="{StaticResource UpGeometry}"
                                    leafui:IconElement.Height="{x:Static sys:Double.NaN}"
                                    leafui:IconElement.Width="{x:Static sys:Double.NaN}"
                                    BorderThickness="0"
                                    Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IncreaseCommand}"
                                    Foreground="{TemplateBinding BorderBrush}"
                                    IsEnabled="{TemplateBinding IsReadOnly,
                                                                Converter={StaticResource BooleanReConverter}}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Visibility="{TemplateBinding ShowUpDownButton,
                                                                 Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button
                                    x:Name="DownButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="Auto"
                                    Height="Auto"
                                    Margin="5,1,5,3"
                                    Padding="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    VerticalContentAlignment="Top"
                                    leafui:IconElement.Geometry="{StaticResource DownGeometry}"
                                    leafui:IconElement.Height="{x:Static sys:Double.NaN}"
                                    leafui:IconElement.Width="{x:Static sys:Double.NaN}"
                                    BorderThickness="0"
                                    Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DecreaseCommand}"
                                    Foreground="{TemplateBinding BorderBrush}"
                                    IsEnabled="{TemplateBinding IsReadOnly,
                                                                Converter={StaticResource BooleanReConverter}}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Visibility="{TemplateBinding ShowUpDownButton,
                                                                 Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="leafui:TitleElement.TitlePlacement" Value="Left">
                            <Setter TargetName="PART_LeftTitleElement" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="leafui:TitleElement.TitlePlacement" Value="Top">
                            <Setter TargetName="PART_TopTitleElement" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource NumberBoxBaseStyle}" TargetType="leafui:NumberBox" />

</ResourceDictionary>